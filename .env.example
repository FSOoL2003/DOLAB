# انسخ هذا الملف باسم .env على السيرفر وعدّل القيم

# كلمة مرور قاعدة البيانات — حروف وأرقام فقط. لتوليد واحدة: openssl rand -hex 24
DB_PASSWORD=change-me

# إيميل المشرف (يقدر يحذف أي إعلان). أكثر من إيميل: افصل بفاصلة
ADMIN_EMAIL=

# بدون دومين اتركها :80 — مع دومين اكتب الدومين، مثل: dolab.sa
SITE_ADDRESS=:80

# اجعلها true بعد تفعيل الدومين وHTTPS
COOKIE_SECURE=false
